<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="database" path="startcoach.db" />
        <exclude domain="database" path="startcoach.db-shm" />
        <exclude domain="database" path="startcoach.db-wal" />
        <exclude domain="sharedpref" path="startcoach_settings.xml" />
        <exclude domain="sharedpref" path="startcoach_secure.xml" />
        <exclude domain="sharedpref" path="startcoach_sync.xml" />
        <exclude domain="sharedpref" path="startcoach_sync_secure.xml" />
        <exclude domain="sharedpref" path="startcoach_suggestion_cache.xml" />
        <exclude domain="sharedpref" path="startcoach_daily_tasks.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="startcoach.db" />
        <exclude domain="database" path="startcoach.db-shm" />
        <exclude domain="database" path="startcoach.db-wal" />
        <exclude domain="sharedpref" path="startcoach_settings.xml" />
        <exclude domain="sharedpref" path="startcoach_secure.xml" />
        <exclude domain="sharedpref" path="startcoach_sync.xml" />
        <exclude domain="sharedpref" path="startcoach_sync_secure.xml" />
        <exclude domain="sharedpref" path="startcoach_suggestion_cache.xml" />
        <exclude domain="sharedpref" path="startcoach_daily_tasks.xml" />
    </device-transfer>
</data-extraction-rules>
